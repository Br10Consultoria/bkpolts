# ============================================================
# OLT BACKUP — CONFIGURAÇÃO GERAL
# Copie para .env e preencha com seus dados reais.
#
# Timezone: fixo em America/Bahia (não configurável)
# ============================================================

# Vendors a executar (separados por vírgula)
# Opções: datacom, zte, parks, fiberhome, huawei, intelbras_g16
VENDOR=datacom

# Horários de execução (padrão: 13h e 22h)
CRON_HOUR_1=13
CRON_HOUR_2=22

# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# ============================================================
# INTERFACE WEB (webui) — cadastro de OLTs e disparo manual de backup
# Acesse em http://<ip-do-servidor>:8080 (docker compose up -d --build)
# NÃO exponha essa porta diretamente na internet, mesmo com login.
# ============================================================
WEBUI_USER=admin
WEBUI_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI
# Fixe uma chave para as sessões sobreviverem a reinícios do container.
# Gere uma com: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=
WEBUI_PORT=8080

# ============================================================
# TFTP — servidor de backup Datacom
# O docker-compose.yml já sobe um serviço "tftp" (container próprio,
# em tftp/Dockerfile) — normalmente TFTP_IP é o IP deste mesmo servidor.
# Veja o README, seção "Servidor de backup Datacom".
# ============================================================
TFTP_IP=0.0.0.0
# Diretório do host compartilhado entre o serviço tftp (grava) e o
# olt-backup/webui (leem) — se vazio, usa um volume Docker nomeado comum.
DATACOM_BACKUP_DIR=

# ============================================================
# FTP (ZTE / Parks / Fiberhome / Huawei)
# ============================================================
FTP_IP=0.0.0.0
FTP_USER=usuario
FTP_PASSWORD=senha

# ============================================================
# OLTs — Formato: NOME:IP:USUARIO:SENHA  (separados por vírgula)
# ============================================================

# Datacom
DATACOM_OLTS=DC1:172.24.25.2:backupolt:SENHA,DC2:172.24.25.6:backupolt:SENHA

# ZTE (padrão — file upload)
ZTE_OLTS=ZTE_ARAMARI:10.100.11.2:sgpoltzte:SENHA

# ZTE Titan (copy ftp root)
ZTE_TITAN_OLTS=ZTE_TITAN_CANAVIEIRAS:10.11.10.10:sgpoltzte:SENHA

# Parks
PARKS_OLTS=OLT_PARKS:10.10.10.50:admin:SENHA

# Fiberhome
FIBERHOME_OLTS=FH_OLT1:10.10.10.60:admin:SENHA

# Huawei
HUAWEI_OLTS=HW_OLT1:10.10.10.70:admin:SENHA

# Intelbras G16 (prompt GPON#)
# Método de backup: ftp (envia config via FTP) ou tftp (envia via TFTP) ou local (salva startup-config localmente)
INTELBRAS_BACKUP_METHOD=ftp
# TFTP_IP (usado quando INTELBRAS_BACKUP_METHOD=tftp) é o mesmo definido
# lá em cima, na seção "TFTP — servidor de backup Datacom".
INTELBRAS_G16_OLTS=G16_OLT1:10.10.10.80:admin:SENHA
